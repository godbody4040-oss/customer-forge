/**
 * REVORA GENERICITY DETECTOR — flags copy that reads like unedited AI/template
 * boilerplate instead of something a real business would say about itself.
 *
 * This is deliberately narrow: it only reads the same flat `texts` array the
 * rest of the Layer 1 quality audit already reads (see quality.ts), so it
 * needs no new data plumbing and can't disagree with what the audit already
 * knows about the site. It never blocks publishing on its own — a business
 * owner is allowed to use plain language — it only lowers the score enough
 * that "make it better" / "make it less generic" has something concrete to
 * act on.
 */
import { safeText } from "./presentation";
import type { QualityIssue } from "./quality";

/**
 * Stock phrases that show up in almost every unedited AI/template site.
 * Matched case-insensitively as substrings, so minor rewording still hits.
 * Kept short and high-precision on purpose — this must never flag a business
 * owner's authentic, plainly-worded copy as a defect.
 */
export const GENERIC_PHRASES: string[] = [
  "welcome to our website",
  "we are dedicated to providing",
  "we are committed to providing",
  "your trusted partner",
  "your one-stop shop",
  "customer satisfaction is our top priority",
  "committed to excellence",
  "quality you can trust",
  "we pride ourselves on",
  "look no further",
  "in today's fast-paced world",
  "at the end of the day",
  "unlock your potential",
  "take your business to the next level",
  "seamless experience",
  "cutting-edge solutions",
  "state-of-the-art",
  "best-in-class",
  "world-class service",
  "we strive to",
];

/** A cliché phrase found in the site's visible text, and how often. */
export type GenericPhraseHit = { phrase: string; count: number };

/** Scans every visible text value for stock marketing phrases. */
export function detectGenericPhrases(texts: unknown[]): GenericPhraseHit[] {
  const counts = new Map<string, number>();
  for (const value of texts) {
    const clean = safeText(value);
    if (!clean) continue;
    const lower = clean.toLowerCase();
    for (const phrase of GENERIC_PHRASES) {
      if (lower.includes(phrase)) counts.set(phrase, (counts.get(phrase) ?? 0) + 1);
    }
  }
  return [...counts.entries()]
    .map(([phrase, count]) => ({ phrase, count }))
    .sort((a, b) => b.count - a.count);
}

/**
 * A short, exact phrase repeated verbatim many times across the visible text
 * (excluding normal repeats like a phone number or a nav label) reads as
 * copy-pasted filler rather than content written for this specific page.
 * Only flags meaningfully long strings so short, legitimately-repeated things
 * (a CTA label, a city name) are never mistaken for the problem.
 */
export function detectRepeatedFiller(texts: unknown[], minLength = 40, minRepeats = 3): GenericPhraseHit[] {
  const counts = new Map<string, number>();
  for (const value of texts) {
    const clean = safeText(value);
    if (!clean || clean.length < minLength) continue;
    const key = clean.toLowerCase();
    counts.set(key, (counts.get(key) ?? 0) + 1);
  }
  return [...counts.entries()]
    .filter(([, count]) => count >= minRepeats)
    .map(([phrase, count]) => ({ phrase, count }));
}

export type GenericityReport = {
  /** 0 = reads entirely generic, 100 = no stock phrases or filler repeats found. */
  score: number;
  phraseHits: GenericPhraseHit[];
  repeatedFiller: GenericPhraseHit[];
};

export function scoreGenericity(texts: unknown[]): GenericityReport {
  const phraseHits = detectGenericPhrases(texts);
  const repeatedFiller = detectRepeatedFiller(texts);
  const phraseHitCount = phraseHits.reduce((total, hit) => total + hit.count, 0);
  const penalty = phraseHitCount * 8 + repeatedFiller.length * 12;
  return { score: Math.max(0, 100 - penalty), phraseHits, repeatedFiller };
}

/** Quality-issue keys this module can produce, for CATEGORY_OF wiring in quality.ts. */
export const GENERICITY_ISSUE_KEYS = ["generic_stock_phrase", "repeated_filler_copy"] as const;

/**
 * Produces QualityIssue entries in the same shape/style as quality.ts's own
 * `issue()` helper, so `auditWebsite` can splice these straight into its
 * existing issues array without any change to QualityIssue itself.
 */
export function genericityIssues(texts: unknown[]): QualityIssue[] {
  const { phraseHits, repeatedFiller } = scoreGenericity(texts);
  const found: QualityIssue[] = [];

  if (phraseHits.length) {
    const examples = phraseHits.slice(0, 3).map((h) => `“${h.phrase}”`).join(", ");
    found.push({
      key: "generic_stock_phrase",
      severity: "advice",
      detail: `The copy uses ${phraseHits.length} stock phrase${phraseHits.length === 1 ? "" : "s"} common to unedited AI/template sites (e.g. ${examples}).`,
      fix: "Rewrite these lines in the business owner's own words — specific to what they actually do and where.",
    });
  }

  if (repeatedFiller.length) {
    found.push({
      key: "repeated_filler_copy",
      severity: "advice",
      detail: `${repeatedFiller.length} block${repeatedFiller.length === 1 ? " is" : "s are"} copy-pasted verbatim in multiple places instead of written for that section.`,
      fix: "Give each section its own wording, even if the underlying message is similar.",
    });
  }

  return found;
}
